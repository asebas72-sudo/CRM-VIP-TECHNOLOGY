# Copie este archivo como .env.local y complete con los datos de su proyecto Supabase
# (Supabase > Project Settings > API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Opcional: lectura de facturas/recibos desde foto (console.anthropic.com > API Keys).
# Sin esta clave, la compra desde foto se registra escribiendo las líneas a mano.
ANTHROPIC_API_KEY=
