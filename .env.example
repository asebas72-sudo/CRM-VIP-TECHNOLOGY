# Copie este archivo como .env.local y complete con los datos de su proyecto Supabase
# (Supabase > Project Settings > API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Clave SECRETA (Supabase > Project Settings > API Keys > Secret keys).
# Solo la usa el servidor para que el superadmin cree usuarios. Nunca la comparta.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Procesar facturas de compra desde el correo (Gmail por IMAP).
# GMAIL_CLAVE_APP es una "contraseña de aplicación" de Google (16 letras), NO la contraseña normal.
GMAIL_USUARIO=vipautomatizaciones@gmail.com
GMAIL_CLAVE_APP=
# Clave larga inventada (mínimo 16 caracteres) para la tarea programada de cron-job.org
CORREO_CRON_TOKEN=

# Opcional: lectura de facturas/recibos desde foto (console.anthropic.com > API Keys).
# Sin esta clave, la compra desde foto se registra escribiendo las líneas a mano.
ANTHROPIC_API_KEY=
